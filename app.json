{
  "expo": {
    "name": "Mova",
    "slug": "aria-sport",
    "scheme": "ariasport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mova/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C100D",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ariasport.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C100D",
        "foregroundImage": "./assets/mova/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/mova/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#BBF246",
          "enableRemoteNotifications": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "09e08644-b412-4329-9a02-20a4ad5f89c3"
      }
    },
    "owner": "brahim.aub",
    "updates": {
      "url": "https://u.expo.dev/09e08644-b412-4329-9a02-20a4ad5f89c3"
    }
  }
}
