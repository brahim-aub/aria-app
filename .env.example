# Copie ce fichier en .env et remplis les valeurs.
EXPO_PUBLIC_GEMINI_API_KEY=

# Supabase (Project Settings > API) : URL du projet et clé publique « anon » / « publishable »
# Ne mets JAMAIS la clé « service_role » / « secret » ici : elle finirait dans l’APK.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
